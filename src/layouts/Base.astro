---
import '../styles/base.css';
const { title, desc, lang, bodyClass } = Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  {desc && <meta name="description" content={desc}>}
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
