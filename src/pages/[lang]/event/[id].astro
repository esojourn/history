---
// 每件大事一个独立页面。内容与时间长河里的全屏卡片是同一段代码生成的。
import Base from '../../../layouts/Base.astro';
import '../../../styles/detail.css';
import { LANGS, build } from '../../../lib/dataset.mjs';
import { createModel } from '../../../lib/model.js';
import { makeCard } from '../../../lib/card.js';

export function getStaticPaths() {
  return LANGS.flatMap(l => build(l.code).events.map(e => ({ params: { lang: l.code, id: e.id } })));
}
const { lang, id } = Astro.params;
const data = build(lang), H = createModel(structuredClone(data), `/${lang}/`), e = H.E[id];
const html = makeCard(H)({ t: 'e', id }, { full: true, page: true });
---
<Base title={`${e.n} · ${H.t('site.title')}`} desc={e.sum} lang={data.htmlLang} bodyClass="page">
  <header class="page-top"><a href={`/${lang}/`}>{H.t('site.title')}</a></header>
  <main class="detail full page" set:html={html} />
</Base>
