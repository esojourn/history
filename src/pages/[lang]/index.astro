---
// 时间长河。这里只有页面骨架；图和交互在 src/river/ 里，数据由浏览器从 /data/<语言>.json 取。
import Base from '../../layouts/Base.astro';
import '../../styles/river.css';
import '../../styles/detail.css';
import { LANGS, build } from '../../lib/dataset.mjs';
import { createModel } from '../../lib/model.js';
import Menu from '../../components/Menu.astro';
import { Content as Readme } from '../../../README.md';      // “说明”弹窗的内容直接取自仓库的 README
import { Content as Changes } from '../../../CHANGELOG.md';  // “更新历史”弹窗的内容取自 CHANGELOG.md
import pkg from '../../../package.json';                     // 菜单底部的版本号
const REPO = 'https://github.com/esojourn/history';

export function getStaticPaths() {
  return LANGS.map(l => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
const data = build(lang), t = createModel(structuredClone(data)).t;
// “时期”菜单：快捷视图按 site.yaml 里的 group 分组；与组同名的那一项（如“中国”）显示成“全程”
const groups = [...new Set(data.site.views.map(v => v.group).filter(Boolean))].map(g => ({ g, views: data.site.views.filter(v => v.group === g) }));
---
<Base title={t('site.title')} desc={t('site.desc')} lang={data.htmlLang} bodyClass="river">
  <div id="app" data-src={`/data/${lang}.json`} data-base={`/${lang}/`} style="display:contents">
    <div id="d" hidden>
      <header class="bar">
        <h1>{t('site.title')}</h1>
        <div class="pm-wrap">
          <div class="seg" role="group">
            {data.site.views.filter(v => v.id === 'world').map(v => <button data-view={v.id}>{t(`view.${v.id}`)}</button>)}
            <button data-periods aria-expanded="false">{t('periods.open')} ▾</button>
          </div>
          <div class="pm" hidden>
            {groups.map(({ g, views }) => <><h3>{t(`viewgroup.${g}`)}</h3><div>{views.map(v => <button data-view={v.id}>{v.id === g ? t('periods.whole') : t(`view.${v.id}`)}</button>)}</div></>)}
          </div>
        </div>
        <div class="seg" role="group">
          <button data-open="all">{t('open.all')}</button><button data-open="none">{t('open.none')}</button>
        </div>
        <button class="find" id="find">{t('search.open')}</button>
        <div class="seg fz" role="group" aria-label={t('fz.label')}><button data-fz="-1" aria-label={t('fz.smaller')}>A−</button><button data-fz="1" aria-label={t('fz.bigger')}>A+</button></div>
        <span class="hint">{t('hint.desktop')}</span>
        <Menu t={t} repo={REPO} version={pkg.version} />
      </header>
      <div class="wrap">
        <div class="stage"><svg id="river" role="img" aria-label={t('river.aria')}></svg></div>
        <div id="note" hidden><span id="note-t"></span><button data-view="focus">{t('note.back')}</button></div>
        <aside id="detail" class="detail"></aside>
      </div>
      <footer class="foot"><span id="legend"></span><span class="lvl" id="lvl"></span></footer>
    </div>

    <div id="m" hidden>
      <header class="bar">
        <h1>{t('site.title')}</h1>
        <button class="find" id="mfind">{t('search.open')}</button>
        <div class="seg fz" role="group" aria-label={t('fz.label')}><button data-fz="-1" aria-label={t('fz.smaller')}>A−</button><button data-fz="1" aria-label={t('fz.bigger')}>A+</button></div>
        <Menu t={t} repo={REPO} version={pkg.version} />
      </header>
      <nav id="mtabs"></nav>
      <div id="mseg" class="mseg"></div>
      <div class="pm-anchor"><div class="pm" hidden>
        {groups.map(({ g, views }) => <><h3>{t(`viewgroup.${g}`)}</h3><div>{views.map(v => <button data-view={v.id}>{v.id === g ? t('periods.whole') : t(`view.${v.id}`)}</button>)}</div></>)}
      </div></div>
      <div id="mbody"></div>
      <aside id="msheet" class="detail sheet"></aside>
    </div>
  </div>
  <dialog id="about" class="about">
    <form method="dialog" class="about-close"><button aria-label={t('about.close')}>×</button></form>
    <div class="about-body">
      <Readme />
      <p class="about-gh">{t('about.github')}<a href={REPO} target="_blank" rel="noopener">{REPO}</a></p>
    </div>
  </dialog>
  <dialog id="changes" class="about">
    <form method="dialog" class="about-close"><button aria-label={t('about.close')}>×</button></form>
    <div class="about-body"><Changes /></div>
  </dialog>
  <script>
    // 顶栏菜单：点三条横线开关；点菜单外面或按 Esc 关上。菜单里的“说明”“更新历史”各开一个弹窗。
    const GH = 'https://github.com/esojourn/history/blob/main/';
    document.querySelectorAll('dialog.about').forEach(dlg => {
      // 弹窗内容取自仓库里的 .md 文件，其中指向仓库文件的相对链接改指到 GitHub
      dlg.querySelectorAll('.about-body a[href]').forEach(a => { const h = a.getAttribute('href'); if (!/^(https?:|#|mailto:)/.test(h)) a.href = GH + h; a.target = '_blank'; a.rel = 'noopener'; });
      dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
    });
    const menus = [...document.querySelectorAll('.menu')];
    const setOpen = (m, on) => { m.querySelector('.menu-pop').hidden = !on; m.querySelector('.menu-btn').setAttribute('aria-expanded', on); };
    menus.forEach(m => {
      m.querySelector('.menu-btn').addEventListener('click', () => setOpen(m, m.querySelector('.menu-pop').hidden));
      m.querySelectorAll('[data-dialog]').forEach(b => b.addEventListener('click', () => { setOpen(m, false); document.getElementById(b.dataset.dialog).showModal(); }));
    });
    document.addEventListener('pointerdown', e => menus.forEach(m => { if (!m.contains(e.target)) setOpen(m, false); }));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') menus.forEach(m => setOpen(m, false)); });
  </script>
  <script>
    import '../../river/main.js';
  </script>
</Base>
