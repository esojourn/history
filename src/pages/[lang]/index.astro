---
// 时间长河。这里只有页面骨架；图和交互在 src/river/ 里，数据由浏览器从 /data/<语言>.json 取。
import Base from '../../layouts/Base.astro';
import '../../styles/river.css';
import '../../styles/detail.css';
import { LANGS, build } from '../../lib/dataset.mjs';
import { createModel } from '../../lib/model.js';
import { Content as Readme } from '../../../README.md';   // “说明”弹窗的内容直接取自仓库的 README
const REPO = 'https://github.com/esojourn/history';

export function getStaticPaths() {
  return LANGS.map(l => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
const data = build(lang), t = createModel(structuredClone(data)).t;
---
<Base title={t('site.title')} desc={t('site.desc')} lang={data.htmlLang} bodyClass="river">
  <div id="app" data-src={`/data/${lang}.json`} data-base={`/${lang}/`} style="display:contents">
    <div id="d" hidden>
      <header class="bar">
        <h1>{t('site.title')}</h1>
        <div class="seg" role="group">
          {data.site.views.filter(v => v.id === 'world').map(v => <button data-view={v.id}>{t(`view.${v.id}`)}</button>)}
        </div>
        <div class="seg" role="group">
          <button data-open="all">{t('open.all')}</button><button data-open="none">{t('open.none')}</button>
        </div>
        <button class="find" id="find">{t('search.open')}</button>
        <button class="about-btn" data-about>{t('about.open')}</button>
        <div class="seg fz" role="group" aria-label={t('fz.label')}><button data-fz="-1" aria-label={t('fz.smaller')}>A−</button><button data-fz="1" aria-label={t('fz.bigger')}>A+</button></div>
        <span class="hint">{t('hint.desktop')}</span>
      </header>
      <div class="wrap">
        <div class="stage"><svg id="river" role="img" aria-label={t('river.aria')}></svg></div>
        <div id="note" hidden><span id="note-t"></span><button data-view="focus">{t('note.back')}</button></div>
        <aside id="detail" class="detail"></aside>
      </div>
      <footer class="foot"><span id="legend"></span><span class="lvl" id="lvl"></span></footer>
    </div>

    <div id="m" hidden>
      <header class="bar">
        <h1>{t('site.title')}</h1>
        <button class="find" id="mfind">{t('search.open')}</button>
        <button class="about-btn" data-about>{t('about.open')}</button>
        <div class="seg fz" role="group" aria-label={t('fz.label')}><button data-fz="-1" aria-label={t('fz.smaller')}>A−</button><button data-fz="1" aria-label={t('fz.bigger')}>A+</button></div>
        <div class="seg" role="group">
          <button data-m="bands" aria-pressed="true">{t('m.bands')}</button><button data-m="people" aria-pressed="false">{t('m.people')}</button>
        </div>
      </header>
      <nav id="mtabs"></nav>
      <div id="mbody"></div>
      <aside id="msheet" class="detail sheet"></aside>
    </div>
  </div>
  <dialog id="about" class="about">
    <form method="dialog" class="about-close"><button aria-label={t('about.close')}>×</button></form>
    <div class="about-body">
      <Readme />
      <p class="about-gh">{t('about.github')}<a href={REPO} target="_blank" rel="noopener">{REPO}</a></p>
    </div>
  </dialog>
  <script>
    // 说明弹窗：README 里指向仓库文件的相对链接改指到 GitHub
    const dlg = document.getElementById('about');
    const GH = 'https://github.com/esojourn/history/blob/main/';
    dlg.querySelectorAll('.about-body a[href]').forEach(a => { const h = a.getAttribute('href'); if (!/^(https?:|#|mailto:)/.test(h)) a.href = GH + h; a.target = '_blank'; a.rel = 'noopener'; });
    document.querySelectorAll('[data-about]').forEach(b => b.addEventListener('click', () => dlg.showModal()));
    dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
  </script>
  <script>
    import '../../river/main.js';
  </script>
</Base>
